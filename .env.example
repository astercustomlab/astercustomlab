# Salin file ini jadi .env.local untuk development di komputer sendiri.
# Di Vercel, isi nilai yang sama lewat Project Settings > Environment Variables.

# Didapat dari Supabase Dashboard > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Nomor WhatsApp bisnis, format internasional tanpa tanda + (contoh: 6281297002395)
NEXT_PUBLIC_WHATSAPP_NUMBER=6281297002395

# URL final website setelah deploy ke Vercel (dipakai untuk SEO: sitemap, Open Graph, dll)
NEXT_PUBLIC_SITE_URL=https://astercustomlab.vercel.app
